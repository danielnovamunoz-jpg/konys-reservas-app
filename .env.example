# Variables de entorno para el build (Vercel → Project Settings → Environment Variables).
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave PÚBLICA "anon" o "publishable". NUNCA la "service_role" / "secret".
SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLICA
# true para actualizaciones en vivo (carta, mesas y reservas)
SUPABASE_REALTIME=true
